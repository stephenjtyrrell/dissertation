# Copy to testing/config.env and adjust to your live environment.

GITHUB_REPO=stephenjtyrrell/dissertation
GITHUB_WORKFLOW_NAME=vendor-agnostic-multicloud-pipeline

# Set this once kubectl points at the Hetzner cluster instead of a local kind context.
KUBE_CONTEXT=

ARGOCD_NAMESPACE=argocd
ARGOCD_APP_PRIMARY=dissertation-sample-api
ARGOCD_APP_PRIMARY_NAMESPACE=dissertation
ARGOCD_APP_SECONDARY=dissertation-test-api
ARGOCD_APP_SECONDARY_NAMESPACE=dissertation-test

EVIDENCE_DIR=testing/evidence
BUNDLE_DIR=testing/evidence/bundles
REPORT_DIR=testing/reports/generated
